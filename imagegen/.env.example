# imagegen reads OPENAI_API_KEY from the process environment first.
#
# Convention (home-server): put the real key in home-server/.env (root,
# gitignored, chmod 600). It is sourced into the shell by scripts/claude.sh
# and the zsh autoload hook, so `imagegen` sees it via os.environ.
#
# Consumers whose key lives in their own repo .env can pass it explicitly:
#   imagegen "..." --env-file /path/to/repo/.env
#
# Never commit the real key. This .example file is the only one tracked.
OPENAI_API_KEY=
