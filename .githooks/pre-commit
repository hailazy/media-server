#!/bin/bash

# Pre-commit hook for media-stack project
# Checks for trailing whitespace and runs shellcheck on modified .sh files

set -e

echo "Running pre-commit checks..."

# Check for trailing whitespace
echo "Checking for trailing whitespace..."
if git diff --cached --check | grep -E '^\+.*\s+$'; then
    echo "ERROR: Trailing whitespace found. Please remove it before committing."
    echo "You can fix this with: git diff --cached --name-only | xargs sed -i 's/[[:space:]]*$//'"
    exit 1
fi

# Run shellcheck on modified .sh files if available
if command -v shellcheck >/dev/null 2>&1; then
    echo "Running shellcheck on modified .sh files..."
    # Get list of modified .sh files in staging area
    shell_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)

    if [ -n "$shell_files" ]; then
        echo "Checking files: $shell_files"
        if ! echo "$shell_files" | xargs shellcheck; then
            echo "ERROR: shellcheck found issues. Please fix them before committing."
            exit 1
        fi
    else
        echo "No .sh files modified, skipping shellcheck."
    fi
else
    echo "shellcheck not found, skipping shell checks."
fi

# --- OPSEC secret-scan (home-server is a PUBLIC repo) ---
# The one hard secret is the 18+ game's SHIPPING TITLE. NSFW infra (LoRA names,
# NoobAI recipes) is intentionally public, so we do NOT grep those. We block the
# shipping title (specific → zero false positives) + a forced-add of local-only data.
echo "Running OPSEC secret-scan..."
if git diff --cached -U0 | grep -iqE '^\+.*ninth[ _-]?bride'; then
    echo "ERROR: OPSEC — the 18+ game shipping title appears in a staged change."
    echo "       home-server is PUBLIC. Use the codename 'chimera' only — never the shipping title."
    git diff --cached -U0 | grep -inE '^\+.*ninth[ _-]?bride' | head
    exit 1
fi
if git diff --cached --name-only | grep -qiE 'imagegen/chimera_dataset|imagegen-queue'; then
    echo "ERROR: OPSEC — staging 18+ training data or the gen queue (must stay local-only)."
    git diff --cached --name-only | grep -iE 'imagegen/chimera_dataset|imagegen-queue'
    exit 1
fi

echo "Pre-commit checks passed."
