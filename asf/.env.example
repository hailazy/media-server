# ASF section — compose-layer tunables.
# ASF core config vẫn là JSON (data/config/ASF.json + bot json) — env chỉ cover mấy biến này.

# Host port cho web UI (bind 127.0.0.1)
ASF_PORT=1242

TZ=Asia/Ho_Chi_Minh

# Bật để encrypt SteamPassword trong bot config (ProtectedByEncryption).
# Để trống/comment = không dùng.
# ASF_CRYPTKEY=
