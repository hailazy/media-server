# ================================================================================================
#                           HIGH-END HARDWARE PERFORMANCE CONFIGURATION
# ================================================================================================
# Performance optimizations for RTX 4070 Ti SUPER + Ryzen 5 7600X3D + 32GB RAM system
# This file contains hardware-specific settings to maximize transcoding performance
# and concurrent user capacity for high-end hardware configurations

# ================================================================================================
#                                    GPU CONFIGURATION (RTX 4070 Ti SUPER)
# ================================================================================================
# NVIDIA RTX 4070 Ti SUPER specific optimizations
# 16GB VRAM with excellent AV1, HEVC, and H.264 encode/decode capabilities

# GPU memory fraction allocation for transcoding workloads
# 0.8 = Use up to 80% of 16GB VRAM (12.8GB) for transcoding
NVIDIA_GPU_MEMORY_FRACTION=0.8

# NVIDIA runtime optimizations for 4070 Ti SUPER
NVIDIA_DRIVER_CAPABILITIES=video,compute,utility,graphics
NVIDIA_VISIBLE_DEVICES=all

# GPU transcoding optimization settings
# Enable all hardware encoding/decoding features of RTX 4070 Ti SUPER
NVIDIA_VIDEO_CODEC_SDK=1
NVIDIA_NVENC_H264=1
NVIDIA_NVENC_HEVC=1
NVIDIA_NVENC_AV1=1
NVIDIA_NVDEC_H264=1
NVIDIA_NVDEC_HEVC=1
NVIDIA_NVDEC_AV1=1

# GPU scheduling optimization for media workloads
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# ================================================================================================
#                                    CPU CONFIGURATION (Ryzen 5 7600X3D)
# ================================================================================================
# CPU optimization for 6 cores/12 threads with 3D V-Cache
# Allocate 8-10 threads to Jellyfin, leaving 2-4 for system processes

# CPU thread allocation (out of 12 available threads)
JELLYFIN_CPU_THREADS=10
JELLYFIN_CPU_CORES=5

# CPU affinity - use cores 0-4 (threads 0-9), leave cores 5 (threads 10-11) for system
JELLYFIN_CPU_AFFINITY=0-9

# CPU scheduling priority for media transcoding
JELLYFIN_CPU_NICE=-5
JELLYFIN_CPU_IOCLASS=1
JELLYFIN_CPU_IOPRIO=3

# Process limits optimized for high-core-count CPU
JELLYFIN_MAX_PROCESSES=512
JELLYFIN_MAX_THREADS=1024

# ================================================================================================
#                                    MEMORY CONFIGURATION (32GB RAM)
# ================================================================================================
# Memory optimization for 32GB system - allow generous allocation

# Jellyfin container memory limits (in bytes)
# 8GB soft limit, 12GB hard limit (leaving 20GB for system and other containers)
JELLYFIN_MEMORY_SOFT_LIMIT=8589934592
JELLYFIN_MEMORY_HARD_LIMIT=12884901888

# Shared memory for GPU-CPU coordination
JELLYFIN_SHM_SIZE=2147483648

# JVM heap settings for Jellyfin (if applicable)
JELLYFIN_JVM_HEAP_INIT=2048m
JELLYFIN_JVM_HEAP_MAX=4096m

# Transcoding cache size (increased from 16GB to 20GB)
JELLYFIN_TRANSCODE_CACHE_SIZE=20G

# ================================================================================================
#                                    STORAGE OPTIMIZATION (NVMe)
# ================================================================================================
# NVMe storage optimizations for high-performance transcoding

# I/O scheduling for NVMe storage
JELLYFIN_IO_SCHEDULER=mq-deadline
JELLYFIN_IO_NICE=-3

# NVMe mount options for optimal performance
NVME_MOUNT_OPTIONS=noatime,nodiratime,compress=none,discard=async

# Transcoding directory optimizations
TRANSCODE_DIR_OPTIONS=noatime,nodev,nosuid,exec,size=20G

# ================================================================================================
#                                    JELLYFIN TRANSCODING SETTINGS
# ================================================================================================
# Hardware-specific transcoding optimizations

# Maximum concurrent transcoding sessions
# RTX 4070 Ti SUPER can handle 8-12 concurrent HEVC/H.264 streams
# or 4-6 concurrent AV1 streams
JELLYFIN_MAX_TRANSCODES=10

# Transcoding quality settings optimized for high-end GPU
JELLYFIN_TRANSCODE_H264_PRESET=p4
JELLYFIN_TRANSCODE_HEVC_PRESET=p4
JELLYFIN_TRANSCODE_AV1_PRESET=5

# Hardware decoding preferences (prioritize GPU)
JELLYFIN_HW_DECODE_PRIORITY=nvdec,vaapi,qsv

# Hardware encoding preferences (prioritize NVENC)
JELLYFIN_HW_ENCODE_PRIORITY=nvenc,vaapi,qsv

# Video memory buffer sizes for high-throughput scenarios
JELLYFIN_VIDEO_BUFFER_SIZE=65536
JELLYFIN_AUDIO_BUFFER_SIZE=16384

# ================================================================================================
#                                    PERFORMANCE MONITORING
# ================================================================================================
# Performance monitoring and logging settings

# Enable performance metrics collection
JELLYFIN_ENABLE_METRICS=true
JELLYFIN_METRICS_INTERVAL=30

# Enhanced logging for performance analysis
JELLYFIN_LOG_LEVEL=Information
JELLYFIN_FFMPEG_LOG_LEVEL=warning

# Resource monitoring
JELLYFIN_MONITOR_GPU=true
JELLYFIN_MONITOR_CPU=true
JELLYFIN_MONITOR_MEMORY=true

# ================================================================================================
#                                    CONTAINER RUNTIME SETTINGS
# ================================================================================================
# Container-level optimizations for high-performance hardware

# Container CPU scheduler settings
CONTAINER_CPU_PERIOD=100000
CONTAINER_CPU_QUOTA=1000000

# Container memory settings
CONTAINER_MEMORY_SWAPPINESS=1
CONTAINER_MEMORY_RESERVATION=4294967296

# Container I/O settings
CONTAINER_BLKIO_WEIGHT=1000
CONTAINER_DEVICE_READ_BPS=/dev/nvme0n1:2147483648
CONTAINER_DEVICE_WRITE_BPS=/dev/nvme0n1:2147483648

# ================================================================================================
#                                        USAGE NOTES
# ================================================================================================
#
# PERFORMANCE EXPECTATIONS:
# With this configuration, your system should achieve:
# - 8-12 concurrent H.264/HEVC transcoding sessions
# - 4-6 concurrent AV1 transcoding sessions  
# - Sub-second seek times with NVMe storage
# - Minimal buffering for direct play scenarios
# - Excellent 4K HDR tone mapping performance
#
# MONITORING:
# Monitor system resources with:
# - podman stats jellyfin
# - nvidia-smi (for GPU utilization)
# - htop (for CPU utilization)
# - iostat (for storage performance)
#
# TUNING:
# Adjust JELLYFIN_MAX_TRANSCODES based on your actual usage patterns
# Higher values = more concurrent users but higher resource usage
# Lower values = more resources per transcode session
#
# TROUBLESHOOTING:
# If experiencing issues:
# 1. Reduce JELLYFIN_MAX_TRANSCODES to 6-8
# 2. Lower memory limits if system becomes unstable
# 3. Check GPU temperature and throttling with nvidia-smi
# 4. Monitor storage I/O with iotop
#
# ================================================================================================